#!/bin/bash

DATA_DIR="${TRIM_PKGVAR:-/var/apps/${TRIM_APPNAME}/var}"
APP_ROOT="$(dirname "${TRIM_APPDEST:-/var/apps/${TRIM_APPNAME}/target}")"

mkdir -p "${DATA_DIR}"
chmod +x "${APP_ROOT}/cmd/"* 2>/dev/null
chmod +x "${TRIM_APPDEST}/bin/"* 2>/dev/null

if [ -n "${wizard_download_dir:-}" ]; then
    printf '%s\n' "${wizard_download_dir}" > "${DATA_DIR}/watch_dirs.txt"
fi

exit 0
